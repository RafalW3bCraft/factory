# .env.example — Factory Environment Variables
# Copy to .env, populate keys, then set safe permissions:
#   cp .env.example .env && chmod 600 .env
# NOTE: Never commit .env to version control!

# Featherless AI API Key (required for OpenCode provider)
FEATHERLESS_API_KEY=

# Absolute path to the git result workspace repository
RESULT_REPO=/absolute/path/to/target/workspace

# Optional runtime overrides:
# OPENCODE_PORT=4096
# MAX_RESTARTS=3
# MISSION_TIMEOUT_S=14400
# TURN_TIMEOUT_S=900
# WORK_ROOT=/absolute/path/to/factory
