# Secrets — keep outside any repo that is pushed
.env
*.env
agent_config.yaml
opencode.json

# Python
__pycache__/
*.py[oc]
.venv/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Node / JS
# NOTE: dist/ and build/ are deliberately NOT ignored. A stage whose Dockerfile
# copies a committed build output would otherwise build on the builder's machine
# but fail from a fresh clone (= a service that does not start = score zero).
node_modules/

# Factory run logs (events.log is copied explicitly by package-submission.sh)
factory/logs/
*.log

# Band room recording — keep off git (large binary, submit separately)
*.mkv

# Local check outputs
checks/

# OS
.DS_Store
Thumbs.db
