# syntax=docker/dockerfile:1
# Dark Factory Sandbox Container (S1 containment)
# Runs seats & OpenCode in an isolated, non-root sandbox with restricted mounts and dropped privileges.

FROM python:3.12-slim

# Prevent interactive prompts and install minimal system tools
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

# Create unprivileged factory user and group
RUN groupadd -g 1000 factory && \
    useradd -u 1000 -g factory -m -s /bin/bash factory

# Create sandboxed workspace mount point
RUN mkdir -p /workspace && chown factory:factory /workspace

# Switch to unprivileged user
USER factory
WORKDIR /workspace

# Set default git pager to cat inside container (non-interactive)
RUN git config --global core.pager cat

# Expose standard unprivileged OpenCode port (localhost only)
EXPOSE 4096

# Container entrypoint
ENTRYPOINT ["/bin/bash"]
