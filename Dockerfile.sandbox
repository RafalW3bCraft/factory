# syntax=docker/dockerfile:1
# Credential-free offline verification image. Provider authentication stays outside.
FROM python:3.13.5-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_NO_CACHE=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 factory && useradd -u 1000 -g factory -m factory
WORKDIR /opt/factory
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
ENV UV_HTTP_TIMEOUT=180 UV_HTTP_RETRIES=3
RUN uv sync --frozen --no-dev --no-editable
ENV PATH="/opt/factory/.venv/bin:$PATH"
RUN mkdir -p /workspace && chown factory:factory /workspace
USER factory
WORKDIR /workspace
CMD ["python", "-m", "factory.sandbox_smoke"]
