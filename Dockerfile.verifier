# Build once, then pass the resulting immutable local image ID to factoryops verify.
FROM python:3.12.14-slim
RUN useradd --system --uid 65534 --non-unique --no-create-home verifier
USER 65534:65534
WORKDIR /candidate
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
CMD ["python", "-B", "-m", "unittest", "discover", "-s", "tests"]
