# Copy to .env, fill in, then: chmod 600 .env     (never commit .env)
FEATHERLESS_API_KEY=
RESULT_REPO=/absolute/path/to/result-repo

# Optional
# MAX_RESTARTS=3        # per-seat auto-restart budget in start-factory.sh
# TURN_TIMEOUT_S=900    # per-turn timeout (raise for long docker builds)
# WORK_ROOT=            # default: parent of this directory
# HARNESS_REPO=         # default: $WORK_ROOT/dark-factory-wearedevs
# CHECKS_DIR=           # default: $WORK_ROOT/checks
